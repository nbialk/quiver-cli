{
  "name": "quiver-cli",
  "version": "2.0.0",
  "description": "Install agent skills from direct GitHub sources, plus custom skills, commands, plugins and MCP servers from catalogs, as native configs for opencode, Claude Code and Codex with per-entry source pins and drift checks.",
  "type": "module",
  "bin": {
    "quiver-cli": "bin/quiver-cli.mjs"
  },
  "files": [
    "bin",
    "dist"
  ],
  "engines": {
    "node": ">=20.12.0"
  },
  "keywords": [
    "agents",
    "agent-skills",
    "mcp",
    "claude-code",
    "opencode",
    "codex",
    "cli",
    "lockfile"
  ],
  "packageManager": "pnpm@12.3.4",
  "dependencies": {
    "@clack/prompts": "^1.8.0",
    "@iarna/toml": "^2.2.5",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "semver": "^7.8.5",
    "tar": "^7.5.22"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/semver": "^7.8.0",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nbialk/quiver-cli.git"
  }
}
